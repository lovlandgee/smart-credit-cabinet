# Copy to .env for local development. Do not commit .env.
POSTGRES_DB=credit_cabinet
POSTGRES_USER=cabinet
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cabinet:replace-with-a-local-password@db:5432/credit_cabinet
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_MINUTES=720
PIPELINE_STEP_DELAY_SEC=1.2
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SEED_ON_START=true
ML_SERVICE_URL=http://ml-service:8100
ML_REQUEST_TIMEOUT=2.0
ML_TRAINING_DATA=/app/data/historical_applications.csv
ML_ARTIFACT_PATH=/app/artifacts/risk_model.joblib
ML_MODEL_VERSION=risk-logistic-v1
ML_DATE_COLUMN=application_date
ML_DRIFT_THRESHOLD=0.2
